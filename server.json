{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.IcaroBichir/lorcana",
  "title": "Disney Lorcana TCG Collection",
  "description": "MCP server for Disney Lorcana TCG: enrich collections, search cards, build decks, audit data.",
  "repository": {
    "url": "https://github.com/IcaroBichir/lorcana-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "lorcana-mcp",
      "version": "1.0.0",
      "runtime": "python",
      "transport": {
        "type": "stdio"
      },
      "installInstructions": "pip install lorcana-mcp",
      "command": "lorcana-mcp serve"
    }
  ]
}
